+def _candidate_hash(candidate: dict[str, object]) -> str:
+    payload = dict(candidate)
+    declared = str(payload.pop("candidate_sha256", ""))
+    actual = hashlib.sha256(canonical_json_bytes(payload)).hexdigest()
+    if declared != actual:
